CHIAKI_AUTH_ENABLED=true

CHIAKI_AUTH_ALLOW_REGISTER=true

CHIAKI_ADMIN_USER=
CHIAKI_ADMIN_EMAIL=
CHIAKI_ADMIN_PASSWORD=

CHIAKI_DB_DIR=./db
CHIAKI_DB_NAME=chiaki.sqlite

CHIAKI_SESSION_DAYS=30
CHIAKI_SESSION_SECRET=change-me-to-a-random-string

CHIAKI_MAX_HOSTS=4

CHIAKI_WASM_PORT=8090

CHIAKI_DISCOVERY_ENABLED=true

CHIAKI_RELAY_ALLOW_WAN=true

# Native TCP/UDP relay. Build with scripts/run-web.ps1 or cargo (see wasm/relay-rust/README.md).
# The Node server still provides authentication, the web UI, and home-agent routing.
CHIAKI_RELAY_BACKEND=rust
# Optional absolute path to chiaki-relay / chiaki-relay.exe:
# CHIAKI_RELAY_BIN=

CHIAKI_SHARE_KEYWORD_PAUSE=false

CHIAKI_CLOUD_URL=

CHIAKI_PUBLIC_ORIGIN=

CHIAKI_TRUST_PROXY=auto
